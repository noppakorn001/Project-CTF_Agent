{
  "description": "CTF-only guardrail for Bash commands in this trusted repository.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/command_guard.py\"",
            "timeout": 5,
            "statusMessage": "Checking CTF command scope"
          }
        ]
      }
    ]
  }
}

